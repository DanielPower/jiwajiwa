{
  "title": "Packing",
  "plot": "On his last night, Alex packs his manga and photos with Yuki and Kenta, and remembers the year.",
  "paragraphs": [
    [["夜だ。", "Night."], ["最後の夜だ。", "The last night."]],
    [["アレックスの部屋。", "Alex's room."], ["マンガ、マンガ、マンガ。", "Manga, manga, manga."]],
    [["ユキ|「マンガ、多いね！」", "\"That's a lot of manga!\""], ["アレックス|「ミホさんの店で、買った。」", "\"I bought them at Miho's shop.\""]],
    [["アレックス|「これは、ケンタの。」", "\"This one's for you, Kenta.\""], ["ケンタ|「…ありがとう。」", "\"…Thanks.\""]],
    [["ユキ|「写真は？」", "\"And the photos?\""], ["アレックス|「写真も！」", "\"Those too!\""]],
    [["桜の写真。", "Sakura photos."], ["祭りの写真。", "Festival photos."], ["花火の写真。", "Fireworks photos."], ["雪の写真。", "Snow photos."]],
    [["ユキの写真。", "Photos of Yuki."], ["ケンタの写真。", "Of Kenta."], ["ミホさんの写真。", "Of Miho."]],
    [["アレックス|「春、夏、秋、冬…」", "\"Spring, summer, autumn, winter…\""], ["ユキ|「いい写真だね。」", "\"They're good photos.\""]],
    [["アレックス|「ユキのコーヒーも、本当に好きだった。」", "\"I really loved your coffee too.\""], ["ユキ|「…ありがとう。」", "\"…Thanks.\""]],
    [["ケンタ|「アレックスの部屋、寂しいね。」", "\"Your room looks lonely, huh.\""], ["ユキ|「…うん。」", "\"…Yeah.\""]],
    [["ケンタ|「…寂しい。」", "\"…I'll miss you.\""]],
    [["ケンタ|「アレックス、ゲーム、やる？」", "\"Alex, want to play?\""], ["アレックス|「やる！最後のゲームだ！」", "\"Yes! One last game!\""]]
  ]
}
