{
  "title": "Rain on the sakura",
  "plot": "On a rainy day Alex and Yuki visit the empty park, and Alex forgets his laundry again.",
  "paragraphs": [
    [["今日は、雨が降ってる。", "It's raining today."]],
    [["アレックス|「桜は？」", "\"What about the sakura?\""], ["ユキ|「雨だね…」", "\"It's raining, huh…\""]],
    [["アレックス|「公園に行きたい！」", "\"I want to go to the park!\""], ["ユキ|「雨だよ？」", "\"In the rain?\""]],
    [["公園に来た。", "They came to the park."], ["人は多くない。", "Hardly anyone there."]],
    [["雨の桜も、きれいだ。", "Sakura in the rain is pretty too."]],
    [["アレックス|「写真、撮る！」", "\"I'm taking a photo!\""], ["ユキ|「いいね。撮って。」", "\"Nice. Go for it.\""]],
    [["ユキ|「春の雨、好き？」", "\"Do you like spring rain?\""], ["アレックス|「好き！」", "\"I do!\""]],
    [["ユキ|「…洗濯は？」", "\"…And your laundry?\""], ["アレックス|「あ…洗濯！」", "\"Oh no… my laundry!\""]]
  ]
